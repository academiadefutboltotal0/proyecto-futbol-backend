ADMIN_USER=admin
ADMIN_PASSWORD=tu_password_aqui
# Opcional (recomendado): hash bcrypt de la contraseña admin. Si se define, tiene prioridad sobre ADMIN_PASSWORD.
# Generar con: node -e "require('bcrypt').hash('tu_password',10).then(console.log)"
ADMIN_PASSWORD_HASH=
JWT_SECRET=una_clave_secreta_larga_y_aleatoria
MONGODB_URI=tu_uri_de_mongodb_aqui
# Dominio(s) permitidos para CORS, separados por coma. Sin esto, acepta cualquier origen.
CORS_ORIGIN=https://tu-frontend.vercel.app

# URL pública del frontend, se usa para armar los links de los correos (activación de cuenta, etc.)
FRONTEND_URL=https://www.captaciones.cl

# Envío de correos (activación de cuenta de apoderado). Sin esto, los correos no se envían
# y solo quedan registrados en la consola del servidor.
# Ejemplo con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=tu_correo@gmail.com,
# SMTP_PASS=una "contraseña de aplicación" generada en la cuenta de Google (no tu clave normal).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Academia Futbol Total <no-reply@captaciones.cl>
